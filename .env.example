# CARDAPÊ — Environment
# Copy to .env.local for local dev. Never commit .env.local

# Supabase (https://supabase.com/dashboard/project/<ref>)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-in-client

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CARDAPÊ

# Optional: Sentry, Resend, Stripe, Mercado Pago, etc. (future)
# SENTRY_DSN=
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
